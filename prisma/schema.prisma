generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ORGANIZER
  STAFF
  ADMIN
}
enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING
}
enum EventStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  CANCELLED
  FINISHED
  ARCHIVED
}
enum ReservationStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}
enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  EXPIRED
}
enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  EXPIRED
}
enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
  REFUNDED
  EXPIRED
}
enum InventoryTransactionType {
  INITIAL
  RESERVATION
  RELEASE
  SALE
  REFUND
  ADJUSTMENT
}
enum TicketGender {
  FEMALE
  MALE
  UNISEX
  NOT_APPLICABLE
}
enum TicketTypeStatus {
  ACTIVE
  INACTIVE
  SOLD_OUT
  EXPIRED
}
enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  OTHER
}
enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
enum CouponType {
  PERCENTAGE
  FIXED
}
enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}
enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model users {
  id                String      @id @default(uuid()) @db.Uuid
  name              String      @db.VarChar(150)
  email             String      @unique @db.VarChar(255)
  phone             String?     @db.VarChar(30)
  password_hash     String?
  role              UserRole    @default(USER)
  status            UserStatus  @default(PENDING)
  avatar_url        String?
  email_verified_at DateTime?   @db.Timestamptz(6)
  created_at        DateTime    @default(now()) @db.Timestamptz(6)
  updated_at        DateTime    @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime?   @db.Timestamptz(6)

  accounts          user_accounts[]
  sessions          sessions[]
  organizer         organizers?
  reservations      reservations[]
  orders            orders[]
  tickets           tickets[]
  favorites         favorites[]
  notifications     notifications[]
  email_logs        email_logs[]
  audit_logs        audit_logs[]
  addresses         user_addresses[]
  ticket_validations ticket_validations[] @relation("ValidationStaff")
  coupon_usages     coupon_usages[]

  @@index([status])
  @@index([role])
  @@map("users")
}

model user_accounts {
  id                 String   @id @default(uuid()) @db.Uuid
  user_id            String   @db.Uuid
  provider           String   @db.VarChar(50)
  provider_account_id String  @db.VarChar(255)
  provider_email     String?  @db.VarChar(255)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @updatedAt @db.Timestamptz(6)
  user               users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_account_id])
  @@index([user_id])
  @@map("user_accounts")
}

model sessions {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token      String   @unique
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
}

model organizers {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @unique @db.Uuid
  name        String   @db.VarChar(150)
  description String?
  logo_url    String?
  email       String?  @db.VarChar(255)
  phone       String?  @db.VarChar(30)
  document    String?  @db.VarChar(50)
  status      String   @default("PENDING") @db.VarChar(30)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)
  user        users    @relation(fields: [user_id], references: [id])
  events      events[]

  @@map("organizers")
}

model venues {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(200)
  description  String?
  address      String?   @db.VarChar(255)
  number       String?   @db.VarChar(30)
  complement   String?   @db.VarChar(100)
  neighborhood String?   @db.VarChar(150)
  city         String    @db.VarChar(150)
  state        String?   @db.VarChar(100)
  country      String    @default("BR") @db.VarChar(2)
  postal_code  String?   @db.VarChar(20)
  latitude     Decimal?  @db.Decimal(10, 7)
  longitude    Decimal?  @db.Decimal(10, 7)
  capacity     Int?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)
  events       events[]

  @@index([city, state])
  @@map("venues")
}

model events {
  id             String      @id @default(uuid()) @db.Uuid
  organizer_id   String      @db.Uuid
  venue_id       String?     @db.Uuid
  name           String      @db.VarChar(200)
  slug           String      @unique @db.VarChar(220)
  description    String?
  banner_url     String?
  thumbnail_url  String?
  category       String?     @db.VarChar(50)
  start_at       DateTime    @db.Timestamptz(6)
  end_at         DateTime?   @db.Timestamptz(6)
  doors_open_at  DateTime?   @db.Timestamptz(6)
  age_rating     String?     @db.VarChar(20)
  status         EventStatus @default(DRAFT)
  published_at   DateTime?   @db.Timestamptz(6)
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime?   @db.Timestamptz(6)
  organizer      organizers  @relation(fields: [organizer_id], references: [id])
  venue          venues?     @relation(fields: [venue_id], references: [id], onDelete: SetNull)
  artists        event_artists[]
  batches        ticket_batches[]
  ticket_types   ticket_types[]
  reservations   reservations[]
  orders         orders[]
  tickets        tickets[]
  validations    ticket_validations[]
  favorites      favorites[]

  @@index([status, start_at])
  @@index([category, start_at])
  @@index([organizer_id])
  @@index([venue_id])
  @@map("events")
}

model artists {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(200)
  description    String?
  image_url      String?
  instagram_url  String?
  website_url    String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @updatedAt @db.Timestamptz(6)
  events         event_artists[]
  @@map("artists")
}

model event_artists {
  event_id  String  @db.Uuid
  artist_id String  @db.Uuid
  position  Int     @default(0)
  event     events  @relation(fields: [event_id], references: [id], onDelete: Cascade)
  artist   artists @relation(fields: [artist_id], references: [id], onDelete: Cascade)
  @@id([event_id, artist_id])
  @@index([artist_id])
  @@map("event_artists")
}

model ticket_batches {
  id          String   @id @default(uuid()) @db.Uuid
  event_id    String   @db.Uuid
  name        String   @db.VarChar(150)
  description String?
  starts_at   DateTime? @db.Timestamptz(6)
  ends_at     DateTime? @db.Timestamptz(6)
  status      String   @default("ACTIVE") @db.VarChar(30)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)
  event       events   @relation(fields: [event_id], references: [id], onDelete: Cascade)
  ticket_types ticket_types[]
  order_items  order_items[]
  @@index([event_id, starts_at, ends_at])
  @@map("ticket_batches")
}

model ticket_types {
  id              String           @id @default(uuid()) @db.Uuid
  event_id        String           @db.Uuid
  ticket_batch_id String?          @db.Uuid
  name            String           @db.VarChar(150)
  description     String?
  gender          TicketGender     @default(NOT_APPLICABLE)
  price           Decimal          @default(0) @db.Decimal(12, 2)
  service_fee     Decimal          @default(0) @db.Decimal(12, 2)
  quantity        Int              @default(0)
  sold_quantity   Int              @default(0)
  reserved_quantity Int            @default(0)
  min_quantity    Int              @default(1)
  max_quantity    Int              @default(5)
  sales_start_at  DateTime?        @db.Timestamptz(6)
  sales_end_at    DateTime?        @db.Timestamptz(6)
  status          TicketTypeStatus @default(ACTIVE)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @updatedAt @db.Timestamptz(6)
  event           events           @relation(fields: [event_id], references: [id], onDelete: Cascade)
  batch           ticket_batches?  @relation(fields: [ticket_batch_id], references: [id], onDelete: SetNull)
  reservation_items reservation_items[]
  order_items     order_items[]
  tickets         tickets[]
  inventory       inventory_transactions[]
  @@index([event_id, status])
  @@index([ticket_batch_id])
  @@map("ticket_types")
}

model reservations {
  id         String            @id @default(uuid()) @db.Uuid
  user_id    String            @db.Uuid
  event_id   String            @db.Uuid
  status     ReservationStatus @default(PENDING)
  expires_at DateTime          @db.Timestamptz(6)
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  updated_at DateTime          @updatedAt @db.Timestamptz(6)
  user       users             @relation(fields: [user_id], references: [id])
  event      events            @relation(fields: [event_id], references: [id])
  items      reservation_items[]
  orders     orders[]
  @@index([user_id, event_id, status])
  @@index([expires_at, status])
  @@map("reservations")
}

model reservation_items {
  id             String       @id @default(uuid()) @db.Uuid
  reservation_id String       @db.Uuid
  ticket_type_id String       @db.Uuid
  quantity       Int
  unit_price     Decimal      @db.Decimal(12, 2)
  total_price    Decimal      @db.Decimal(12, 2)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  reservation    reservations @relation(fields: [reservation_id], references: [id], onDelete: Cascade)
  ticket_type    ticket_types @relation(fields: [ticket_type_id], references: [id])
  @@index([reservation_id])
  @@map("reservation_items")
}

model orders {
  id             String      @id @default(uuid()) @db.Uuid
  user_id        String      @db.Uuid
  event_id       String      @db.Uuid
  reservation_id  String?     @db.Uuid
  order_number   String      @unique @db.VarChar(50)
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  service_fee    Decimal     @default(0) @db.Decimal(12, 2)
  discount       Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @default(0) @db.Decimal(12, 2)
  currency       String      @default("BRL") @db.Char(3)
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  updated_at     DateTime    @updatedAt @db.Timestamptz(6)
  paid_at        DateTime?   @db.Timestamptz(6)
  cancelled_at   DateTime?   @db.Timestamptz(6)
  user           users       @relation(fields: [user_id], references: [id])
  event          events      @relation(fields: [event_id], references: [id])
  reservation    reservations? @relation(fields: [reservation_id], references: [id], onDelete: SetNull)
  items          order_items[]
  payments       payments[]
  tickets        tickets[]
  refunds        refunds[]
  coupon_usage   coupon_usages?
  @@index([user_id, created_at])
  @@index([event_id, status])
  @@map("orders")
}

model order_items {
  id              String         @id @default(uuid()) @db.Uuid
  order_id        String         @db.Uuid
  ticket_type_id  String         @db.Uuid
  ticket_batch_id String?        @db.Uuid
  quantity        Int
  unit_price      Decimal        @db.Decimal(12, 2)
  service_fee     Decimal        @default(0) @db.Decimal(12, 2)
  total_price     Decimal        @db.Decimal(12, 2)
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  order           orders         @relation(fields: [order_id], references: [id], onDelete: Cascade)
  ticket_type     ticket_types   @relation(fields: [ticket_type_id], references: [id])
  ticket_batch    ticket_batches? @relation(fields: [ticket_batch_id], references: [id], onDelete: SetNull)
  tickets         tickets[]
  @@index([order_id])
  @@map("order_items")
}

model payments {
  id                   String        @id @default(uuid()) @db.Uuid
  order_id             String        @db.Uuid
  provider             String        @db.VarChar(50)
  provider_payment_id  String?       @db.VarChar(255)
  method               PaymentMethod @default(OTHER)
  status               PaymentStatus @default(PENDING)
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("BRL") @db.Char(3)
  failure_reason       String?
  paid_at              DateTime?     @db.Timestamptz(6)
  expires_at           DateTime?     @db.Timestamptz(6)
  created_at           DateTime      @default(now()) @db.Timestamptz(6)
  updated_at           DateTime      @updatedAt @db.Timestamptz(6)
  order                orders        @relation(fields: [order_id], references: [id])
  webhooks             payment_webhooks[]
  refunds              refunds[]
  @@unique([provider, provider_payment_id])
  @@index([order_id, status])
  @@map("payments")
}

model payment_webhooks {
  id                 String    @id @default(uuid()) @db.Uuid
  provider           String    @db.VarChar(50)
  external_event_id  String    @db.VarChar(255)
  payment_id         String?   @db.Uuid
  event_type         String?   @db.VarChar(150)
  payload            Json
  processed          Boolean   @default(false)
  processed_at       DateTime? @db.Timestamptz(6)
  error_message      String?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  payment            payments? @relation(fields: [payment_id], references: [id], onDelete: SetNull)
  @@unique([provider, external_event_id])
  @@index([processed, created_at])
  @@map("payment_webhooks")
}

model tickets {
  id              String       @id @default(uuid()) @db.Uuid
  order_id        String       @db.Uuid
  order_item_id   String       @db.Uuid
  user_id         String       @db.Uuid
  event_id        String       @db.Uuid
  ticket_type_id  String       @db.Uuid
  code            String       @unique @db.VarChar(100)
  qr_token_hash   String       @unique
  status          TicketStatus @default(ACTIVE)
  issued_at       DateTime     @default(now()) @db.Timestamptz(6)
  used_at         DateTime?    @db.Timestamptz(6)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime     @updatedAt @db.Timestamptz(6)
  order           orders       @relation(fields: [order_id], references: [id])
  order_item      order_items  @relation(fields: [order_item_id], references: [id])
  user            users        @relation(fields: [user_id], references: [id])
  event           events       @relation(fields: [event_id], references: [id])
  ticket_type     ticket_types @relation(fields: [ticket_type_id], references: [id])
  validations     ticket_validations[]
  @@index([user_id, status])
  @@index([event_id, status])
  @@map("tickets")
}

model ticket_validations {
  id                String   @id @default(uuid()) @db.Uuid
  ticket_id         String   @db.Uuid
  event_id          String   @db.Uuid
  staff_user_id     String?  @db.Uuid
  validated_at      DateTime @default(now()) @db.Timestamptz(6)
  result            String   @db.VarChar(50)
  device_identifier String?  @db.VarChar(255)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  ticket            tickets  @relation(fields: [ticket_id], references: [id])
  event             events   @relation(fields: [event_id], references: [id])
  staff_user        users?   @relation("ValidationStaff", fields: [staff_user_id], references: [id], onDelete: SetNull)
  @@index([ticket_id, validated_at])
  @@index([event_id, validated_at])
  @@map("ticket_validations")
}

model inventory_transactions {
  id             String                    @id @default(uuid()) @db.Uuid
  ticket_type_id String                    @db.Uuid
  type           InventoryTransactionType
  quantity       Int
  reference_type String?                   @db.VarChar(50)
  reference_id   String?                   @db.Uuid
  created_at     DateTime                  @default(now()) @db.Timestamptz(6)
  ticket_type    ticket_types              @relation(fields: [ticket_type_id], references: [id])
  @@index([ticket_type_id, created_at])
  @@index([reference_type, reference_id])
  @@map("inventory_transactions")
}

model refunds {
  id                 String       @id @default(uuid()) @db.Uuid
  payment_id         String       @db.Uuid
  order_id           String       @db.Uuid
  amount             Decimal      @db.Decimal(12, 2)
  reason             String?
  status             RefundStatus @default(PENDING)
  provider_refund_id String?      @db.VarChar(255)
  created_at         DateTime     @default(now()) @db.Timestamptz(6)
  completed_at       DateTime?    @db.Timestamptz(6)
  payment            payments     @relation(fields: [payment_id], references: [id])
  order              orders       @relation(fields: [order_id], references: [id])
  @@index([order_id, status])
  @@map("refunds")
}

model coupons {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique @db.VarChar(50)
  description String?
  type        CouponType
  value       Decimal      @db.Decimal(12, 2)
  max_uses    Int?
  used_count  Int          @default(0)
  starts_at   DateTime?    @db.Timestamptz(6)
  expires_at  DateTime?    @db.Timestamptz(6)
  status      CouponStatus @default(ACTIVE)
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime     @updatedAt @db.Timestamptz(6)
  usages      coupon_usages[]
  @@index([status, starts_at, expires_at])
  @@map("coupons")
}

model coupon_usages {
  id              String   @id @default(uuid()) @db.Uuid
  coupon_id       String   @db.Uuid
  user_id         String   @db.Uuid
  order_id        String   @unique @db.Uuid
  discount_amount Decimal  @db.Decimal(12, 2)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  coupon          coupons  @relation(fields: [coupon_id], references: [id])
  user            users    @relation(fields: [user_id], references: [id])
  order           orders   @relation(fields: [order_id], references: [id])
  @@unique([coupon_id, user_id, order_id])
  @@map("coupon_usages")
}

model favorites {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  event_id   String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event      events   @relation(fields: [event_id], references: [id], onDelete: Cascade)
  @@unique([user_id, event_id])
  @@map("favorites")
}

model notifications {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  type       String   @db.VarChar(50)
  title      String   @db.VarChar(200)
  message    String
  read_at    DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@index([user_id, read_at, created_at])
  @@map("notifications")
}

model email_logs {
  id                  String      @id @default(uuid()) @db.Uuid
  user_id             String?     @db.Uuid
  recipient           String      @db.VarChar(255)
  template            String      @db.VarChar(100)
  status              EmailStatus @default(PENDING)
  provider_message_id String?     @db.VarChar(255)
  error_message       String?
  sent_at             DateTime?   @db.Timestamptz(6)
  created_at          DateTime    @default(now()) @db.Timestamptz(6)
  user                users?      @relation(fields: [user_id], references: [id], onDelete: SetNull)
  @@index([status, created_at])
  @@map("email_logs")
}

model user_addresses {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @db.Uuid
  label        String?  @db.VarChar(50)
  postal_code  String?  @db.VarChar(20)
  street       String   @db.VarChar(255)
  number       String   @db.VarChar(30)
  complement   String?
  neighborhood String?
  city         String
  state        String
  country      String   @default("BR") @db.VarChar(2)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)
  user         users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  @@index([user_id])
  @@map("user_addresses")
}

model audit_logs {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String?  @db.Uuid
  action     String   @db.VarChar(100)
  entity     String   @db.VarChar(100)
  entity_id  String?  @db.Uuid
  old_data   Json?
  new_data   Json?
  ip_address String?  @db.Inet
  user_agent String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       users?   @relation(fields: [user_id], references: [id], onDelete: SetNull)
  @@index([entity, entity_id])
  @@index([user_id, created_at])
  @@map("audit_logs")
}
